# Remover o .exemplo e adicionar os valores

# === CONFIGURAÇÃO DE AMBIENTE ===
# Ambiente: development, test, staging, production, sandbox
SICOOB_ENVIRONMENT=production

# === CREDENCIAIS ===
SICOOB_CLIENT_ID=?
SICOOB_CERTIFICADO=?
SICOOB_CHAVE_PRIVADA=?
SICOOB_CERTIFICADO_PFX=?
SICOOB_SENHA_PFX=?
SICOOB_SANDBOX_TOKEN=?
SICOOB_SANDBOX_CLIENT_ID=?

# === CONFIGURAÇÕES AVANÇADAS (OPCIONAL) ===
# URLs customizadas (se necessário)
# SICOOB_BASE_URL=https://api.sicoob.com.br
# SICOOB_AUTH_URL=https://auth.sicoob.com.br/auth/realms/cooperado/protocol/openid-connect/token

# Timeout e configurações de rede
# SICOOB_TIMEOUT=30
# SICOOB_MAX_RETRIES=3

# Configurações de logging
# SICOOB_LOG_LEVEL=INFO
# SICOOB_LOG_FORMAT=json
# SICOOB_LOG_REQUESTS=false
# SICOOB_LOG_RESPONSES=false

# Configurações de segurança
# SICOOB_DEBUG_MODE=false
# SICOOB_VERIFY_SSL=true
